# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# RAW DATASETS - never commit (licences + real phishing emails with live links)
data/raw/

# Processed data and trained models (large, can be regenerated)
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Run logs (regenerated by scripts); figures ARE kept for the report
results/logs/*
!results/logs/.gitkeep

# Editor / OS files
.vscode/
.DS_Store
Thumbs.db
